{
  "name": "vision-mcp-for-ds",
  "version": "1.2.0",
  "description": "Vision MCP for DS — 给 DeepSeek V4 等纯文本模型补齐视觉能力的通用 MCP 桥，基于 OpenAI 兼容视觉模型（OpenCode Go / 智谱 GLM / Qwen-VL 等），跨 Reasonix / ZCode / WorkBuddy。",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "vision-mcp-for-ds": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "pack": "bash scripts/pack.sh",
    "healthcheck": "bash scripts/health-check.sh",
    "verify:config": "bash scripts/verify-config.sh",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist",
    "scripts",
    "README.md",
    ".env.example",
    "config.example.json",
    "mcp-config.example.json"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Dellety/vision-mcp-for-ds.git"
  },
  "keywords": [
    "mcp",
    "vision",
    "multimodal",
    "deepseek",
    "ds-v4",
    "opencode",
    "opencode-go",
    "mimo",
    "glm",
    "zhipu",
    "openai-compatible",
    "image-analysis",
    "ocr"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
