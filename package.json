{
  "name": "vision-mcp-for-reasonix",
  "version": "1.1.0",
  "description": "Vision MCP for Reasonix — 给 DeepSeek 的 Reasonix 终端 agent 补齐视觉能力，基于智谱 GLM-4.6V 等 OpenAI 兼容视觉模型。",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "vision-mcp-for-reasonix": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "pack": "bash scripts/pack.sh",
    "healthcheck": "bash scripts/health-check.sh",
    "verify:config": "bash scripts/verify-config.sh",
    "prepare": "npm run build"
  },
  "files": [
    "dist",
    "scripts",
    "README.md",
    ".env.example",
    "config.example.json",
    "mcp-config.example.json"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Dellety/vision-mcp-for-reasonix.git"
  },
  "keywords": [
    "mcp",
    "vision",
    "multimodal",
    "reasonix",
    "deepseek",
    "glm-4.6v",
    "zhipu",
    "openai-compatible",
    "image-analysis",
    "ocr"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
