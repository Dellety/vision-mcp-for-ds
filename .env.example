# Vision MCP for Reasonix Configuration
# Copy this file to `.env` and modify as needed.
#
# 最简启动（推荐，面向联网 API）：
#   VISION_PROFILE=zhipu
#   VISION_API_KEY=你的智谱key
#
# API Key 只走环境变量，不要写入任何提交到仓库的文件。

# ─── Profile 预设（任选其一）─────────────────────────────────────
# 可选值: zhipu | openai | qwen | local
# 每个 profile 自带正确的端点和默认模型，无需手填 baseUrl。
# 不设置时默认 local（本地模型，端点 http://localhost:8000）。
VISION_PROFILE=zhipu

# ─── API Key（必填，除本地模型外）──────────────────────────────
# 智谱: https://open.bigmodel.cn 控制台获取
# 只在此处或 Reasonix/MCP 客户端的 env 中填写，切勿提交。
VISION_API_KEY=

# ─── 可选：覆盖 profile 的具体字段 ──────────────────────────────
# 仅当想换端点或模型时才需要取消注释。
# 例如智谱端点但用免费模型 glm-4.6v-flash：
# VISION_MODEL=glm-4.6v-flash

# VISION_BASE_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions
# VISION_MODEL=glm-4.6v-flashx
# VISION_MAX_TOKENS=4096
# VISION_TEMPERATURE=0.7
