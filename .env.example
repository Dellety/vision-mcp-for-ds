# Vision MCP for DS Configuration
# Copy this file to `.env` and modify as needed.
#
# 最简启动（推荐，面向联网 API）：
#   VISION_PROFILE=opencode
#   VISION_API_KEY=你的 OpenCode Go key
#
# API Key 只走环境变量，不要写入任何提交到仓库的文件。

# ─── Profile 预设（任选其一）─────────────────────────────────────
# 可选值: opencode | zhipu | openai | qwen | local
# 每个 profile 自带正确的端点和默认模型，无需手填 baseUrl。
# 不设置时默认 opencode（OpenCode Go 套餐，默认模型 MiMo-V2.5）。
VISION_PROFILE=opencode

# ─── API Key（必填，除本地模型外）──────────────────────────────
# opencode: OpenCode Zen 控制台获取 (https://opencode.ai/go)
# 只在此处或 MCP 客户端的 env 中填写，切勿提交。
VISION_API_KEY=

# ─── 可选：覆盖 profile 的具体字段 ──────────────────────────────
# 仅当想换端点或模型时才需要取消注释。
# 例如用 OpenCode Go 套餐的 GLM-5.2：
# VISION_MODEL=glm-5.2
# 例如用 Kimi K3：
# VISION_MODEL=kimi-k3

# VISION_BASE_URL=https://opencode.ai/zen/go/v1/chat/completions
# VISION_MODEL=mimo-v2.5
# VISION_MAX_TOKENS=4096
# VISION_TEMPERATURE=0.7
